<%- include ../partial/header.ejs %>
<%- include ../partial/navbar.ejs %>



<main class="container">
    <div class="row">
        <div class ="offset-md-1 col-md-10">
            <h1><%= title %></h1>
            <br><br>
            <a href="/add" class="btn-btn-add">
                <i class="fa-solid fa-plus"></i> Add Product
            </a>
            <br><br>
            <table class="table table-bordered table-striped table-hover ">
                <tr>
                    <th class="text-center col-2">Product</th>
                    <th class="text-center col-1">Location</th>
                    <th class="text-center col-1">Price($)</th>
                </tr>
                <% for(let count=0;count<itemlist.length;count++) {%>
                    <tr>
                        <td class="text-center col-2"><%=itemlist[count].item%></td>
                        <td class="text-center col-1"><%=itemlist[count].location%></td>
                        <td class="text-center col-1"><%=itemlist[count].price%></td>
                        <td class="text-center col-1">
                            <a href="/edit/<%= itemlist[count]._id%>"
                                class="btn-btn-edit">
                                <i class="fa-solid fa-pen-to-square"></i> Edit
                            </a>
                        </td>
                        <td class="text-center col-1">
                            <a href="/delete/<%= itemlist[count]._id%>"
                                class="btn-btn-delete">
                                <i class="fa-solid fa-trash"></i> Delete
                            </a>
                        </td>
                    <!--this allows the code to read the information inside 
                    the database and displays it-->
                    </tr>
                <%} %>
            </table>
        </div>
    </div>


    
</main>
<%- include ../partial/footer.ejs %>


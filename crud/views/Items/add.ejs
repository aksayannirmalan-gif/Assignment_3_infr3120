<%- include ../partial/header.ejs %>
<%- include ../partial/navbar.ejs %>
<!-- form for the add page-->
<div class ="container">
    <div class ="row">
        <div class="offset-md-3 col-md-6">
            <h1><%=title%></h1>
            <form class="form" method="post">
                <div class="form-group">
                    <label for="titleTextField"> Product Name</label>
                    <input type="text" class="form-control" id="titleTextField"
                    placeholder="Enter the Product name"
                    name="item" required>
                </div>
                <br>
                <div class="form-group">
                    <label for="locationTextField"> Product Location</label>
                    <input type="text" class="form-control" id="locationTextField"
                    placeholder="Enter where to buy product"
                    name="location" required>
                </div>
                <br>
                <div class="form-group">
                    <label for="priceTextField"> Product Price</label>
                    <input type="text" class="form-control" id="priceTextField"
                    placeholder="Enter cost of product"
                    name="price" required>
                </div>
                <br>
                <button class="btn-btn-primary" type="submit">
                    <i class="fa-solid fa-check"></i> Submit
                </button>
                <a href="/" class="btn-btn-warning">
                    <i class="fa-solid fa-arrow-rotate-left"></i> Cancel
                </a>
            </form>
        </div>
    </div>
</div>
<%- include ../partial/footer.ejs %>